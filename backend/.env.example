# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# If not provided or unavailable, backend automatically falls back to an in-memory MongoDB instance
MONGODB_URI=mongodb://localhost:27017/ai_chat_assistant

# AI Provider ("openai", "claude", or "mock" / auto-fallback)
AI_PROVIDER=openai

# API Keys (Set the one you wish to use)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-3-5-sonnet-20241022
