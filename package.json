{
  "name": "ai-chat-assistant",
  "version": "1.0.0",
  "description": "Intelligent AI Chat Assistant with Real-Time Streaming, Tone Control, and MongoDB Persistence",
  "main": "backend/src/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "cd backend && npm start",
    "build": "cd frontend && npm run build"
  },
  "keywords": [
    "ai-chat-assistant",
    "vibe-coding",
    "real-time-streaming",
    "tone-toggle",
    "mongodb",
    "openai",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
